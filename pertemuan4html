<!DOCTYPE html>
<html lang="en">
<head>
    <title>Pertemuan 1</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <header id="main-header">
        <h1 class="title">Form kehadiran</h1>
    </header>
  <div class="container">
    <form id="form-kehadiran" method="post" target="_blank">
        <label for="nama">Nama:</label>
        <input type="text" id="nama" placeholder="nama lengkap"><br><br>
        <label for="npm">NPM:</label>
        <input type="number" placeholder="Masukkan NPM"> <br> <br>
        <label for="kelas">Kelas:</label>
        <select id="kelas" name="pilih kelas">
            <option value="SI">SI</option>
            <option value="Ilokm">Ilkom</option>
            <option selected disabled hidden>Plih Kelas</option>
        </select> <br><br>
        <label for="date">Tamggal:</label>
        <input type="date"><br><br>
        <label for="waktu">Waktu:</label>
        <input type="time" placeholder="...."><br><br>
        <input type="submit" id="btn-submit" value="Submit">
    </form>
  </div>

</body>
</html>